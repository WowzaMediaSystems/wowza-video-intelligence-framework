{
	"active":true,
	"app_name": "live",
	"stream_name": "vlm.*",
	"vif_event_listeners": {
		"Id3Tags": {
			"class_name": "Id3Event",
			"methods": ["immediate"]
		},
		"Webhooks": {
			"class_name": "WebhookEvent2",
			"methods": ["disabled"]
		},
		"LogFiles": {
			"class_name": "LogFileEvent",
			"methods": ["immediate"]
		},
		"Overlays": {
			"class_name": "OverlayEvent",
			"methods": ["immediate"],
			"properties": {
				"debug_string": "'Cur time:' HH:mm:ss.SSS yyyy-MM-dd",
				"show_stats": true
			}
		}
	},
	"frame_buffer": 10,
	//VLM requests are heavier than scene/object inference: 2 fps over a
	//2 second window sends one request of 4 frames every 2 seconds. The bundled
	//vLLM sidecar allows at most 8 images per prompt, so keep
	//duration x inference_fps at 8 or below (-1 = match source exceeds it).
	"inference_fps": 2,
	"duration": 2,

	"detector_type":"vlm",
	"vlm_analysis": {
		//model_name and endpoint_url are inherited from the global vlm_analysis
		//defaults above (the bundled vLLM sidecar); override here to use a
		//different model or endpoint for this stream.
		//
		//This is "Detect" mode (default): class_names is open vocabulary — any
		//short word or phrase works (e.g. "person wearing a hard hat"). The
		//engine surfaces per-class results only.
		"class_names":["fire","smoke","person","vehicle"]
		//
		//Optional render-only per-class hints disambiguate a class at a few
		//prompt tokens' cost; each key must be one of class_names:
		//"class_hints": { "fire": "visible open flame, not red lighting" }
		//
		//"Describe" mode: remove class_names (and prompts) entirely -> a
		//free-form description per window (class_name "description").
		//
		//"Custom" mode: supply your own prompt(s) and (optionally) a schema.
		//Prompts support {class_list}, {frame_count} and {duration_seconds}:
		//"user_prompt": "Read the gauge in {frame_count} frame(s); report the value.",
		//"system_prompt": "You are a precise instrument reader.",
		//"response_schema": { "type": "object", "properties": { "reading": { "type": "number" } }, "required": ["reading"] }
		//
		//Detect "Reasoning Level" (speed vs. accuracy): the class_names block
		//above is High (strongest grounding, per-class reasoning text, slowest).
		//For faster decode add reasoning_level plus its prompts and a per-class
		//boolean schema -> Low/Medium need system_prompt + user_prompt +
		//response_schema together (a partial block is treated as High). The
		//Manager UI writes these for you; hand-written example for Medium below
		//(scene-first schema; Low omits the "scene" property and uses the Low
		//prompts). Never put reasoning_level in the global vlm_analysis defaults
		//block -> the schema is per-stream, so it must live on the stream.
		//"reasoning_level": "medium",
		//"system_prompt": "You are a strict visual detector over a time-ordered clip from ONE video. First identify what the footage actually is. Test patterns, SMPTE color bars, solid-color frames, slates, black frames or graphics contain NONE of the target classes — report every class as absent. Judge only what is clearly, literally visible; never infer from context or expectation.",
		//"user_prompt": "These are {frame_count} frames over ~{duration_seconds}s from one clip, in time order. Candidate classes:\n{class_list}\nIn `scene`, name what the footage is in <=6 words. Then, for each candidate, set true ONLY if it is clearly visible in at least one frame, and false otherwise.",
		//"response_schema": { "type": "object", "properties": { "scene": { "type": "string", "description": "what the footage is, <=6 words" }, "fire": { "type": "boolean" }, "smoke": { "type": "boolean" }, "person": { "type": "boolean" }, "vehicle": { "type": "boolean" } }, "required": ["scene","fire","smoke","person","vehicle"], "additionalProperties": false },
		//"max_tokens": 128,
		//"temperature": 0.0
	}
}
