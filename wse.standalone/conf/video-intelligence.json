{
    "original_version" : "1.0.0",
    "current_version": "1.0.0",
    //defaults for each stream defined below in the streams[]
    "active":false, //if we should do vi on the stream
    "vi_service_url":"${VIS_PROTOCOL}://${VIS_HOST}:${VIS_PORT}/ws/stream/",  //where the vif service is hosted
    "vi_service_api_key":"${VIS_API_KEY}",  //api key used to connect to vif service
    //"model_idle_timeout_seconds": 60, //how long a model should stay loaded with no streams before it is unloaded, default is 60 seconds
    "ignore_untracked_objects": false, //ignore untracked objects when tracking_method is set

    "vif_event_listeners": {
        //list of listeners to recieve VIF events, such as overlays, id3 tags, customer modules.
    },

    "rollup_batch_interval": 2,  //how long to hold detections for batch and rollup events
    //"auto_frame_throttle": false, //opt-in (default off, all modes): reduce inference_fps when inference falls behind. object detection: its latency lever; scene/vlm: a pre-step before catch_up_to_live skips. Renamed from auto_scene_frame_throttle (still accepted on read).
    "catch_up_to_live": true, //scene/vlm only: when inference stays slower than real-time, skip the stale backlog to the live edge instead of trailing by the whole buffer depth. Temporary slowdowns are still absorbed by the buffer. (Object bounds latency via auto_frame_throttle instead — it can't skip without breaking tracking.) Detections carry behind_live_ms; scene/vlm carry caught_up/skipped_frames/skipped_ms on the first detection after a skip.
    //"catch_up_max_behind_seconds": 2, //scene/vlm: how far (seconds) detections may fall behind live before catch-up skips; unset = 2s, bounding latency near (inference_time + 2s); lower for tighter latency, raise to tolerate more lag. object: not used (object latency is bounded by the inference_fps throttle; the slow-inference warning fires at a fixed ~1s single-frame round-trip).

    "grayscaled": false, //converts images to grayscale to improve performance
    "duration": 2, //how many seconds to send (scene/vlm only)
    "use_transcoder": true, //whether to use transcoder to capture frames
    "frame_grab_interval": 1, //if not using transcoder, how often to capture frames in seconds
    "inference_fps": -1, //target fps for inference, -1 matches source fps
    "inference_video_height": 0, //-1 matches source video height, 0 matches model, values > 0 resize video to that height
    "frame_buffer": 10, //buffer to hold frames to process

    // how many parallel instances to create for each model type.
    // default values are tuned for a NVIDIA T4 GPU, if your GPU
    // has more CUDA cores it could benefit from higher values.
    // Monitor the GPU usage % and increase these values if you notice
    // less than 50% GPU usage at full load.
    "concurrent_executions": {
        "scene_detection": {
            "default": 1
        },
        "object_detection": {
            "default": 10
        }
    },
    //debugging options
    "save_images": false,   //save images from transcoder to /tmp/vi/<stream_name>
    "log_timing": 0,        //how long to write logging details to /tmp/vi/<stream_name>
    "log_max_messages": 20, //maximum number of log messages to write in wse access log for vi/ws/wss messages. -1 is all, 0 is disabled

    "motion_analysis": {},
    "object_analysis": {
        // default to to object tracking, the only other valid option is "byte-track"
        "tracking_method": "none",
        // if tracking_method is not null, use these properties for ByteTrack
        "byte_track_properties": {
            // minimum confidence score for a single-frame detection to turn into a new tracked object
            "track_creation_minimum_confidence": 0.5,
            // how many frames can a tracked object without active detections remain tracked before it's removed
            "max_lost_track_frames_before_track_removal": 30,
            // value between 0.0 and 1.0, determining the percentage (0.2 corresponds to 20%) of overlap that
            // consecutive detections require in order to be considered the same tracked object
            "minimum_consecutive_track_overlap": 0.2,
            // how many consecutive frames the same object has to be tracked internally before it becomes
            // a visible tracked object
            "track_creation_minimum_consecutive_frames": 3
        },
        // minimum confidence for a detection to be considered by the tracking algorithm. Usually this number is lower
        // than track_creation_minimum_confidence, as it can be used to sustain existing tracked object with lower
        // confidence scores compared to the score required for a new detection track to start
        "confidence_threshold": 0.3,
        // For custom trained models, the path to the .pt or pth files containing its weights. Absolute path or relative path
        // relative to the VIF Service execution context
        "checkpoint_path": null,
        // model variant for RF-DETR. When checkpoint_path is specified, it completely overrides model_name; model_name is ignored.
        "model_name": "medium"  //options are: nano, small, medium, large
    },
    "scene_analysis": {
      "confidence_threshold":0.3,
      "sensitivity":5
    },
    "vlm_analysis" : {
        // defaults below match the vLLM sidecar bundled with the Video Intelligence
        // framework (docker compose --profile vlm), so VLM streams work out of the box.
        // Point endpoint_url at any OpenAI-compatible endpoint to use another provider.
        "model_name": "Qwen/Qwen3-VL-4B-Instruct-FP8",
        "endpoint_url": "http://vlm.docker:8000/v1"
        //"api_key": "your-api-key" //only needed for authenticated endpoints; the bundled sidecar needs none
    },
    "streams":
    [
        {
            "active":true,
            "app_name": "live",         //application to watch
            "stream_name": "object.*",  //regex pattern to match incoming streams to
            "vif_event_listeners": {
                "Id3Tags": {
                    // "class_name": "com.wowza.wms.plugin.videointelligence.event.Id3Event",
                    "class_name": "Id3Event",
                    "methods": ["rollup"],
                    "suppress_empty_detections": true //if true, will not send rollup events if there are no detections in the holdback window
                },
                "Webhooks": {
                    "class_name": "WebhookEvent2",
                    "methods": ["disabled"]
                },
                "LogFiles": {
                    "class_name": "LogFileEvent",
                    "methods": ["batch"]
                },
                "Overlays": {
                    "class_name": "OverlayEvent",
                    "methods": ["immediate"],
                    "confidence_threshold": 0.3,
                    "properties": {
                        "debug_string": "'Cur time:' HH:mm:ss.SSS yyyy-MM-dd",  //show a string that can include current time such as "'Cur time:' HH:mm:ss MM-dd-yyyy" as a video overlay
                        "show_stats": true, //show performance stats as a video overlay
                        "overlay_thread_drawing": false, //draw overlays in a thread to be safe
                        "replace_video": true, //replaces the existing video with captured
                        "fade_step": 20 //how many frames it takes to fade objects out once they are no longer tracked
                    }
                }
            },
            "rollup_batch_interval": 2,
            "grayscaled": false,
            "log_timing": 0,
            "save_images": false,
            "frame_buffer": 10,
            "inference_fps": 12,

            "detector_type":"object",
            "object_analysis": {
                "tracking_method": "byte-track",
                "byte_track_properties": {
                    "track_creation_minimum_confidence": 0.5,
                    "max_lost_track_frames_before_track_removal": 30,
                    "minimum_consecutive_track_overlap": 0.2,
                    "track_creation_minimum_consecutive_frames": 3
                },
                "confidence_threshold": 0.3,
                "class_names": ["airplane", "apple", "backpack", "banana", "baseball bat", "knife", "laptop", "scissors", "person", "car", "surfboard", "motorcycle", "truck", "traffic light", "bus", "skateboard", "tv", "cell phone", "chair", "elephant", "stop sign"],
                "model_name": "medium"
            }
        },
        {
            "active":true,
            "app_name": "live",
            "stream_name": "scene.*",
            "vif_event_listeners": {
                "Id3Tags": {
                    "class_name": "Id3Event",
                    "methods": ["immediate"]
                },
                "Webhooks": {
                    "class_name": "WebhookEvent2",
                    "methods": ["disabled"]
                },
                "LogFiles": {
                    "class_name": "LogFileEvent",
                    "methods": ["immediate"]
                },
                "Overlays": {
                    "class_name": "OverlayEvent",
                    "confidence_threshold": 0.7,
                    "methods": ["immediate"],
                    "properties": {
                        "jitter": 2,
                        "debug_string": "'Cur time:' HH:mm:ss.SSS yyyy-MM-dd",
                        "show_stats": true
                    }
                 }
            },
            "frame_buffer": 10,
            "inference_fps": 5,
            "duration": 2,

            "detector_type":"scene",
            "scene_analysis": {
                "class_names":["fire","fighting","running", "person climbing fence","crowd of people","taking pictures","walking","standing","color bars"],
                "sensitivity": 5
            }
        },
        {
            "active":true,
            "app_name": "live",
            "stream_name": "vlm.*",
            "vif_event_listeners": {
                "Id3Tags": {
                    "class_name": "Id3Event",
                    "methods": ["immediate"]
                },
                "Webhooks": {
                    "class_name": "WebhookEvent2",
                    "methods": ["disabled"]
                },
                "LogFiles": {
                    "class_name": "LogFileEvent",
                    "methods": ["immediate"]
                },
                "Overlays": {
                    "class_name": "OverlayEvent",
                    "methods": ["immediate"],
                    "properties": {
                        "debug_string": "'Cur time:' HH:mm:ss.SSS yyyy-MM-dd",
                        "show_stats": true
                    }
                }
            },
            "frame_buffer": 10,
            //VLM requests are heavier than scene/object inference: 2 fps over a
            //2 second window sends one request of 4 frames every 2 seconds.
            "inference_fps": 2,
            "duration": 2,

            "detector_type":"vlm",
            "vlm_analysis": {
                //model_name and endpoint_url are inherited from the global vlm_analysis
                //defaults above (the bundled vLLM sidecar); override here to use a
                //different model or endpoint for this stream.
                //class_names is open vocabulary: any short word or phrase works (e.g.
                //"person wearing a hard hat"). Keep it set: the engine surfaces
                //per-class results only.
                "class_names":["fire","smoke","person","vehicle"]
            }
        }
    ]
}
