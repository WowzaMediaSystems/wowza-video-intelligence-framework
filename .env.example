# Example .env file for wse-vi-framework
# Copy this file to `.env` and edit the values before running docker-compose commands

# Wowza Streaming Engine license (replace with your license key)
WSE_LICENSE_KEY=REPLACE_WITH_YOUR_WSE_LICENSE_KEY

# Admin credentials used by the container (used for bootstrapping)
WSE_ADMIN_USER=admin
WSE_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Comma-separated source IPs/wildcards allowed to reach the WSE REST interface.
# Defaults to localhost only; widen to specific IPs/subnets (e.g.
# 10.0.0.0/8,192.168.1.*), or set `*` to allow any IP (least secure).
IPWHITELIST=127.0.0.1,172.*.*.*,192.168.*.*,10.*.*.*

# Information required to connect Engine to the VI Service

# Transport Engine uses to dial VIS. Valid values: ws, wss.
#
# !! SECURITY: ws:// is plaintext. It is ONLY safe when VIS runs on the SAME
# !! host as Engine (traffic stays on the internal Docker bridge, the default
# !! below). If VIS_HOST points at a SEPARATE host, you MUST use wss -- front
# !! VIS with the bundled tls-proxy overlay (docker-compose.tls-proxy.yaml; see
# !! VIS_TLS_PORT below and docs/VIS_DEPLOYMENT.md) or your own reverse proxy.
VIS_PROTOCOL=ws
  # The hostname where VIS is hosted. The default below is correct for
  # local Docker deployments where Engine and VIS run on the same machine;
  # change it only when VIS runs on a different host (then VIS_PROTOCOL must
  # be wss -- see the security note above).
  VIS_HOST=video-intelligence-service.docker
# The port where VIS is listening. Default: 5001. When using the tls-proxy
# overlay, point this at VIS_TLS_PORT (5443) on the proxy host instead.
VIS_PORT=5001
# Host port published by the optional tls-proxy overlay (terminates TLS in
# front of VIS for remote deployments). Only used when you merge
# docker-compose.tls-proxy.yaml with `-f` (see docs/VIS_DEPLOYMENT.md).
#VIS_TLS_PORT=5443
# Arbitrary api-key used to secure the communication between Wowza Streaming
# Engine and the Video Intelligence Service. Required when SECURE_MODE=true
# (the default) -- generate a strong random value, e.g. `openssl rand -hex 32`.
VIS_API_KEY=

# Fail closed: when true (the default), VIS refuses to start without a
# non-empty VIS_API_KEY. Set to false only for air-gapped/internal-only
# deployments that consciously opt out of authentication.
SECURE_MODE=true

# VIS license string (required for Video Intelligence Service)
VIS_LICENSE=REPLACE_WITH_YOUR_VIS_LICENSE

# ── Managed VLM engines (optional; `--profile vlm`) ─────────────────────────
# One engine container per catalog model. The models in VIS's active set
# serve, each on its GPU; the active set and its Default are changed through
# VIS (the Manager's VLM section, or POST /vlm/models/<id>/activate to move the
# Default) rather than by editing this file. Bring them up with:
#   docker compose --profile default --profile vlm up -d
# Streams point at http://video-intelligence-service.docker:5001/v1.
# Full reference: docs/VLM_GUIDE.md.

# Optional API key for the VLM endpoint. Never generated: unset, the endpoint
# and the engines' control calls need no key, and the internal engine network
# is the protection. Set it when you publish VIS's port for other machines --
# the managed /v1 does not take VIS_API_KEY. Streams then pass the same value
# as api_key.
#VLLM_API_KEY=

# Optional HuggingFace token: higher rate limits on the first-boot weight
# downloads, and required for gated models (Gemma: accept its license first).
# A token can also be saved from the Manager; one set here wins over it.
#HF_TOKEN=

# Air-gapped hosts with pre-seeded ./vis/vlm-models: set to 1 to skip
# HuggingFace Hub probes at boot
#HF_HUB_OFFLINE=1

# A HuggingFace mirror for the weight downloads and the token checks.
# Default: https://huggingface.co
#HF_ENDPOINT=

# Hosts where vLLM sleep mode cannot run (no CUDA UVA, e.g. WSL2): rest every
# engine parked instead of asleep. Bringing a model up is then a cold start.
#VLM_FORCE_ALL_COLD=true

# Host RAM (MiB) kept back from sleeping engines. Unset = derived from the
# host (the larger of 40% of RAM and 8 GiB).
#VLM_RAM_RESERVE_MIB=

# Largest LoRA adapter archive the Manager may upload, in MB. Default: 1024.
#VLM_ADAPTER_MAX_UPLOAD_MB=

# Fallback card for an engine whose spec pins none; VIS pins each active
# model's GPU itself. A single index also places the first active model VIS
# seeds. Leave it unset.
#VLM_GPU_IDS=

# The catalog overlay, as a path inside the VIS container. Default:
# ./models/vlm-catalog.local.json (./vis/models/vlm-catalog.local.json here).
#VLM_CATALOG_OVERLAY=

# Your own models: add one to the catalog overlay. The slots start with the
# `vlm` profile and VIS assigns each a model the overlay adds. To pin a model
# to a slot instead, name the overlay entry's id here. See docs/VLM_GUIDE.md.
#VIF_SLOT_1_MODEL=
#VIF_SLOT_2_MODEL=

# ── NVIDIA Jetson (L4T / JetPack, arm64) ─────────────────────────────────
# On a Jetson device, uncomment the line below to use the Jetson images.
#COMPOSE_FILE=docker-compose.yaml:docker-compose.jetson.yaml

# ── Synthetic Video Detector NIM sidecar (optional; `--profile svd`) ───────
# Backs the `detector_type=synthetic` analyzer. The NIM image is
# access-gated through NVIDIA NGC / AI Enterprise (VI-550 partnership); run
# `docker login nvcr.io` (user: $oauthtoken, pass: your NGC key) once first.
# Full deploy + air-gap + GPU-matrix guide: docs/SYNTHETIC_VIDEO_DETECTOR.md

# NGC API key: authenticates the image pull and the first-boot model download.
# How to get one: join NVIDIA's AI for Media Private Access Program, then create
# an NGC key with at least the NGC Catalog permission (see the guide above).
#NGC_API_KEY=

# On a multi-GPU host, give the NIM its own card so it doesn't contend with
# Engine/VIS on GPU 0: edit the `svd` service's device reservation in
# docker-compose.yaml, replacing `count: all` with e.g. `device_ids: ["1"]`
# (indices match `nvidia-smi`). There is no .env knob for this -- an
# NVIDIA_VISIBLE_DEVICES pin is overridden by the device reservation the NIM
# needs for GPU video decode.

# Override the NIM image (default: nvcr.io/nim/nvidia/synthetic-video-detector:latest)
#SVD_NIM_IMAGE=

# Force a GPU-architecture manifest profile id. Leave this COMMENTED OUT to
# let the NIM auto-select the right profile for your GPU (the default). Only
# uncomment it to pin a profile (e.g. for air-gapped pre-seeding); see
# docs/SYNTHETIC_VIDEO_DETECTOR.md for the per-arch ids. Do not uncomment it
# with an empty value -- an empty-but-set value suppresses auto-selection and
# the NIM won't start.
#NIM_MANIFEST_PROFILE=

# Hosted / bring-your-own SVD endpoint instead of the local sidecar — set
# these in the stream's synthetic config (endpoint/api_key/function_id), not
# here. The hosted NVCF dev endpoint is grpc.nvcf.nvidia.com:443.
#NVCF_API_KEY=
#SVD_FUNCTION_ID=
