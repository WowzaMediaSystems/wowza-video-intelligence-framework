# Environment of docker-compose.standalone.yaml (Model Trainer on its own).
#   cp .env.standalone.example .env.standalone
#   docker compose -f docker-compose.standalone.yaml --env-file .env.standalone up -d
# The file holds the key: never commit it.

# Required. The sign-in secret of the page at http://<host>:8090 and the
# X-API-Key of the API. Any long random string will do.
MODEL_TRAINER_API_KEY=

# Host port of the UI and the API (default 8090).
#MODEL_TRAINER_PORT=

# Image of the service; see docs/MODEL_TRAINER.md ("Before you start").
#MODEL_TRAINER_IMAGE=

# Optional Video Intelligence Service. Training can publish a trained model
# to it and the VLM grounding backend of the boxes step calls its managed
# /v1 endpoint. Leave empty to run without it.
#VIS_URL=http://your-vis-host:5001
#VIS_API_KEY=
#VLLM_API_KEY=

# Largest uploaded video, in MiB (default 4096).
#MODEL_TRAINER_MAX_VIDEO_MB=

# Lifetime of the browser session in seconds (default 28800, 8 hours).
#MODEL_TRAINER_SESSION_TTL_SECONDS=

# Dataset versions kept per project (default 5) and the largest COCO or CVAT
# file the review step imports, in MiB (default 256).
#MODEL_TRAINER_DATASET_KEEP=
#MODEL_TRAINER_MAX_IMPORT_MB=

# Largest example image in MiB (default 512) and the retention of finished
# training jobs (default 10 jobs, 30 days).
#MODEL_TRAINER_MAX_UPLOAD_MB=
#MODEL_TRAINER_MAX_JOBS=
#MODEL_TRAINER_JOB_TTL_SECONDS=

# Air-gapped: do not reach Hugging Face (pre-seed ./model_trainer/models and
# ./model_trainer/hf-cache first).
#HF_HUB_OFFLINE=1

# Only for a host that accepts unauthenticated access: SECURE_MODE=false
# lets the service start without MODEL_TRAINER_API_KEY.
#SECURE_MODE=true
