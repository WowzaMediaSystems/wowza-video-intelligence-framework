# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). Needs the vllm/vllm-openai:v0.26.0 image plus the
# vlm-patches/cosmos3_edge.py mount (vLLM PR #49190 cherry-pick).
VLM_MODEL=nvidia/Cosmos3-Edge
# fp8-quantize the BF16 weights (7.7 GB) at load time so an 8 GB card fits.
# --max-cudagraph-capture-size caps graph capture at batch 64 instead of the 512 default
# Not needed with a 48 GB VRAM GPU.
VLM_EXTRA_ARGS=--quantization fp8 --allowed-local-media-path / --max-cudagraph-capture-size=64
VLM_MAX_MODEL_LEN=16384
VLM_MAX_NUM_BATCHED_TOKENS=8192
# Per-image pixel caps (Qwen-style processor kwargs; ~1k vision tokens/image).
VLM_MIN_PIXELS=4096
VLM_MAX_PIXELS=1003520
# Fraction of the GPU vLLM reserves. Default 0.90 assumes a dedicated card;
# lower to 0.4-0.5 only when the VLM must share its GPU with heavier workloads
VLM_GPU_MEMORY_UTILIZATION=0.80
