# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- knobs left unset fall back to
# the entrypoint's defaults. GPU placement and credentials are NOT here: they
# come from the compose service (VLM_GPU_IDS) and .env (secrets).
VLM_MODEL=nvidia/Cosmos3-Edge
# fp8-quantize the BF16 weights (7.7 GB) at load time so an 8 GB card fits.
# SMALL-GPU TUNING (see docs/VLM_GUIDE.md) -- on a 40 GB+ card drop
# --quantization fp8 for full BF16, and --max-cudagraph-capture-size, which
# caps graph capture at batch 64 instead of 512: saves VRAM, slows big batches.
VLM_EXTRA_ARGS=--quantization fp8 --allowed-local-media-path / --max-cudagraph-capture-size=64 --default-chat-template-kwargs {"enable_thinking":false}
VLM_MAX_MODEL_LEN=16384
VLM_MAX_NUM_BATCHED_TOKENS=8192
# Per-image pixel caps (Qwen-style processor kwargs; ~1k vision tokens/image).
VLM_MIN_PIXELS=4096
VLM_MAX_PIXELS=1003520
# Fraction of the GPU vLLM reserves. Default 0.90 assumes a dedicated card;
# lower to 0.4-0.5 only when the VLM must share its GPU with heavier workloads
VLM_GPU_MEMORY_UTILIZATION=0.80
