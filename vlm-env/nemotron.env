# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- knobs left unset fall back to
# the entrypoint's defaults. GPU placement and credentials are NOT here: they
# come from the compose service (VLM_GPU_IDS) and .env (secrets).
VLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
VLM_MAX_MODEL_LEN=8192
# SMALL-GPU TUNING -- drop --enforce-eager on a 40 GB+ card. See docs/VLM_GUIDE.md,
# "The shipped model files are tuned for small GPUs". It disables CUDA graph
# capture outright: saves VRAM and startup time, at the cost of per-request
# latency on every request. (--max-cudagraph-capture-size is a no-op while
# --enforce-eager is set; it only starts mattering once you drop it.)
# --structured-outputs-config pins guided JSON to xgrammar with free whitespace
# disabled; keep it (docs/VLM_GUIDE.md, "Structured output").
VLM_EXTRA_ARGS=--quantization modelopt --trust-remote-code --enforce-eager --max-cudagraph-capture-size=64 --structured-outputs-config {"backend":"xgrammar","disable_any_whitespace":true}
# Fraction of the GPU vLLM reserves. Default 0.80 assumes a dedicated card;
# lower to 0.6-0.7 only when the VLM must share its GPU, only on a 40 GB+ card.
VLM_GPU_MEMORY_UTILIZATION=0.80
