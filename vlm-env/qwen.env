# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- the entrypoint's defaults
# already fit Qwen3-VL-4B on a 24 GB card. GPU placement and credentials are
# NOT here: they come from the compose service (VLM_GPU_IDS) and .env (secrets).
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8
# --max-cudagraph-capture-size caps graph capture at batch 64 instead of the 512 default
# Not needed with a 48 GB VRAM GPU.
VLM_EXTRA_ARGS=--max-cudagraph-capture-size=64
VLM_MAX_MODEL_LEN=16384
# Per-image pixel caps (Qwen-style processor kwargs; ~512 vision tokens/image).
VLM_MIN_PIXELS=3136
VLM_MAX_PIXELS=401408
# Fraction of the GPU vLLM reserves. Default 0.90 assumes a dedicated card;
# lower to 0.4-0.5 only when the VLM must share its GPU with heavier workloads
VLM_GPU_MEMORY_UTILIZATION=0.80
