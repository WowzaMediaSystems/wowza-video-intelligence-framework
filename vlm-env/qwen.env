# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- knobs left unset fall back to
# the entrypoint's defaults. GPU placement and credentials are NOT here: they
# come from the compose service (VLM_GPU_IDS) and .env (secrets).
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8
# SMALL-GPU TUNING -- drop this flag on a 40 GB+ card. See docs/VLM_GUIDE.md,
# "The shipped model files are tuned for small GPUs". --max-cudagraph-capture-size
# caps CUDA graph capture at batch 64 instead of vLLM's 512 default: saves VRAM
# and startup time, but every batch above 64 falls back to the slower eager path.
VLM_EXTRA_ARGS=--max-cudagraph-capture-size=64
VLM_MAX_MODEL_LEN=16384
# Per-image pixel caps (Qwen-style processor kwargs; ~512 vision tokens/image).
VLM_MIN_PIXELS=3136
VLM_MAX_PIXELS=401408
# Fraction of the GPU vLLM reserves. Default 0.90 assumes a dedicated card;
# lower to 0.4-0.5 only when the VLM must share its GPU with heavier workloads
VLM_GPU_MEMORY_UTILIZATION=0.80
