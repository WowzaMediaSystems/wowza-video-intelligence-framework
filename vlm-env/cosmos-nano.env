# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- knobs left unset fall back to
# the entrypoint's defaults. GPU placement and credentials are NOT here: they
# come from the compose service (VLM_GPU_IDS) and .env (secrets).
VLM_MODEL=nvidia/Cosmos3-Nano
# TIGHT-VRAM TUNING -- --enforce-eager is here because ~32 GB of weights leave
# little room for CUDA graphs on a 40-48 GB card. On an 80 GB card (or 2x 24 GB
# with VLM_TENSOR_PARALLEL_SIZE=2) drop it: capture costs VRAM and startup time,
# but eager mode costs per-request latency on every request. See docs/VLM_GUIDE.md,
# "The shipped model files are tuned for small GPUs". (--max-cudagraph-capture-size
# is a no-op while --enforce-eager is set; it only matters once you drop it.)
VLM_EXTRA_ARGS=--enforce-eager --max-cudagraph-capture-size=64
VLM_MAX_MODEL_LEN=16384
VLM_MAX_NUM_SEQS=1
# Per-image pixel caps (Qwen-style processor kwargs; ~512 vision tokens/image).
VLM_MIN_PIXELS=3136
VLM_MAX_PIXELS=401408
# Fraction of the GPU vLLM reserves. Default 0.87 assumes a dedicated card;
# lower to 0.6-0.7 only when the VLM must share its GPU, only on a 40 GB+ card.
VLM_GPU_MEMORY_UTILIZATION=0.87
