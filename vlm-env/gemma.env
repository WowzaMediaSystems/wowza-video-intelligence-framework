# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). All values are optional -- knobs left unset fall back to
# the entrypoint's defaults. GPU placement and credentials are NOT here: they
# come from the compose service (VLM_GPU_IDS) and .env (secrets).
# Requires: HF_TOKEN in .env -- Gemma 3 is a GATED model, so accept its license
# on HuggingFace first or the first-boot weight download 401s.
VLM_MODEL=google/gemma-3-4b-it
# SMALL-GPU TUNING -- drop --max-cudagraph-capture-size on a 40 GB+ card. See
# docs/VLM_GUIDE.md, "The shipped model files are tuned for small GPUs". It caps
# CUDA graph capture at batch 64 instead of vLLM's 512 default: saves VRAM and
# startup time, but every batch above 64 falls back to the slower eager path.
VLM_EXTRA_ARGS=--trust-remote-code --mm-processor-kwargs={} --max-cudagraph-capture-size=64
VLM_MAX_MODEL_LEN=32768
# Fraction of the GPU vLLM reserves. Default 0.80 assumes a dedicated card;
# lower to 0.4-0.5 only when the VLM must share its GPU with heavier workloads
VLM_GPU_MEMORY_UTILIZATION=0.8
