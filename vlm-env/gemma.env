# VLM model config for the vLLM sidecar (loaded via `env_file:` in
# docker-compose.yaml). GPU placement and credentials are NOT here: they come
# from the compose service (VLM_GPU_IDS) and .env (secrets).
# Gemma 3 is a GATED model: accept the license on HuggingFace and set HF_TOKEN
# in .env, or the first-boot weight download 401s.
# Gemma's SigLIP processor rejects Qwen-style min/max_pixels kwargs, so no
# VLM_MIN_PIXELS / VLM_MAX_PIXELS here (same as nemotron.env).
VLM_MODEL=google/gemma-3-4b-it
VLM_EXTRA_ARGS=--trust-remote-code --mm-processor-kwargs={}
VLM_MAX_MODEL_LEN=32768
