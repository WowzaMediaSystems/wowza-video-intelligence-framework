# Qwen3-VL 2B — el miembro más chico de la familia, afinado para una GPU de 8 GB.
#
# Pensado para el e2e de perfiles de detector (VIF-DOC1-P4-3), donde lo que se
# afirma es la resolución de configuración y la forma en el cable, no la calidad
# de la inferencia: alcanza con que el endpoint conteste.
#
# 2B en bf16 pesa ~4,4 GB y ya está en ./vis/vlm-models, así que arranca sin
# descargar nada. La variante FP8 es más liviana todavía (~2,2 GB, deja más
# lugar para KV cache) pero hay que bajarla:
#   VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct-FP8
VLM_MODEL=Qwen/Qwen3-VL-2B-Instruct

# Ventana corta a propósito: en 8 GB el KV cache es lo que compite con los pesos,
# y las ventanas de este e2e son de 2-5 s de frames, no de conversación larga.
VLM_MAX_MODEL_LEN=4096
VLM_MAX_NUM_BATCHED_TOKENS=4096
VLM_MAX_NUM_SEQS=4

VLM_GPU_MEMORY_UTILIZATION=0.85

# Los frames que VIC manda por ventana. VIS descubre el tope real del endpoint en
# runtime a partir del 400 que devuelve, así que este número es un límite, no un
# contrato — pero ponerlo bajo evita el ciclo de descubrimiento en cada arranque.
VLM_MAX_IMAGES_PER_PROMPT=4

# Resolución por imagen. El techo son ~401k píxeles (≈ 640x628), suficiente para
# leer una escena de CCTV y muy por debajo de lo que haría entrar en OOM.
VLM_MIN_PIXELS=3136
VLM_MAX_PIXELS=401408

# Sin captura de grafos CUDA: ahorra memoria y unos minutos de arranque, a costa
# de latencia por request. Para un e2e de configuración es el intercambio correcto.
VLM_EXTRA_ARGS=--enforce-eager
